# Raman Medical Research Database Configuration

# Database Configuration
DB_NAME=raman_research
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Flask Secret Key (change this to a random string in production)
SECRET_KEY=change-this-to-a-random-secret-key # openssl rand -base64 32

# Session settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CORS settings (if needed)
ALLOWED_ORIGINS=https://your-domain.com

# Patient ID Configuration
# Starting patient ID for auto-assignment
# This should be set to approximately where your existing data is (if any)
# Default: 1500
STARTING_PATIENT_ID=1500

# Application Settings
FLASK_ENV=production
FLASK_DEBUG=False

# Host ports the app is published on (change these if they conflict with other apps).
# HTTP_PORT  -> nginx front door (recommended entry point; handles proxying, HTTP/2, etc.)
# WEB_PORT   -> direct access to gunicorn, bypassing nginx
# Port 80 is often already in use (e.g. the Unraid web UI), so HTTP_PORT defaults to 8099.
HTTP_PORT=8099
WEB_PORT=5000

# Backup Settings
BACKUP_CONFIG_FILE=backup_config.json
BACKUP_DIRECTORY=/mnt/medical_backups/raman_backups
BACKUP_RETENTION_DAYS=90

# Background Export Settings
# Directory where generated export files are stored (shared between the web and
# export_worker containers). Defaults to /exports inside the container.
EXPORT_DIRECTORY=/exports
# Hours a finished export file is kept before it is automatically deleted.
EXPORT_RETENTION_HOURS=24
